rules_version = '2';

service firebase.storage {
  match /users/{userId}/audio/{vocabId} {
    allow read, write: if request.auth != null && request.auth.uid == userId
                       && firestore.get(/databases/(default)/documents/rateLimits/$(userId)).data.isPremium == true
                       && firestore.get(/databases/(default)/documents/rateLimits/$(userId)).data.audioBytesUsed
                        + request.resource.size <= 50 * 1024 * 1024; // 50 MB
  }
}
